<Project>

  <PropertyGroup>
    <!-- See https://www.nuget.org/packages/JetBrains.ReSharper.SDK -->
    <!-- Keep in sync with ProductVersion in gradle.properties -->
    <SdkVersion>2026.2.2</SdkVersion>

    <Title>Rider Tests Support Plus</Title>
    <Description>Saves and loads unit test sessions, including parametrized tests resolved by name, and imports sessions from .runsettings (TestCaseFilter or NUnit Where).</Description>

    <Authors>Łukasz Mastalerz</Authors>
    <Copyright>Copyright $([System.DateTime]::Now.Year) Łukasz Mastalerz</Copyright>
    <PackageTags>resharper rider plugin unit-testing nunit runsettings vstest</PackageTags>

    <PackageProjectUrl>https://eu.buddy.works/lakasabasz/ridertestssupportplus</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIconUrl></PackageIconUrl>
  </PropertyGroup>

</Project>
